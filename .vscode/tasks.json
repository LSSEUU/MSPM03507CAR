{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "rebuild (Keil)",
            "type": "shell",
            "command": "powershell",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/build.ps1", "-Mode", "Rebuild"],
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": [],
            "detail": "Resolve local Keil installation and perform a full target rebuild"
        },
        {
            "label": "host regression tests",
            "type": "shell",
            "command": "powershell",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/test.ps1"],
            "group": "test",
            "problemMatcher": []
        }
    ]
}
